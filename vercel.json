{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/complete-lessons",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/generate-invoices",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/check-progression",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/priority-queue",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/fala-refresh",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/postcode-refresh-alert",
      "schedule": "0 8 1 8 *"
    },
    {
      "path": "/api/cron/reset-demo-environment",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/delta-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/re-engagement",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/academic-year-transition",
      "schedule": "0 6 1 8 *"
    }
  ]
}
