# amber-esol-backend — environment variables
# Copy to .env and fill in. Never commit .env. Keep this example in sync as
# new vars are added.

# ── REQUIRED for startup ────────────────────────────────────────────────
# Server crashes / 500s on every request if these are missing.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/amber-dev?retryWrites=true

# Used to sign user JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-random-bytes-hex

# ── REQUIRED for ESOL referral flow ─────────────────────────────────────
# Signs the JWT inside each org-issued referral link. Different key from
# JWT_SECRET so they can be rotated independently. Generate same way.
REFERRAL_JWT_SECRET=replace-with-different-64-random-bytes-hex
# How long an issued referral JWT remains valid. Brief default: 365 days.
# Format follows jsonwebtoken (e.g. "365d", "30d", "12h").
REFERRAL_JWT_EXPIRES_IN=365d

# ── REQUIRED for cron jobs (Vercel cron hits these endpoints) ───────────
CRON_SECRET=replace-with-32-random-bytes-hex
# Separate secret for the monthly invoice generation cron — lets it be
# rotated independently of the general CRON_SECRET (e.g. shared with
# Joey's finance scripts later without exposing the other cron paths).
INVOICE_CRON_SECRET=replace-with-32-random-bytes-hex

# ── REQUIRED for compliance + academic-year defaults ────────────────────
# Used by ComplianceConfigService as the fallback when a request doesn't
# pass an explicit academic_year. The service ALSO computes the current
# year from the system clock (1-August UK boundary); this is the override.
ACADEMIC_YEAR=2025/26

# ── REQUIRED for ILR exports + funding claims ───────────────────────────
# Amber Training Ltd's UK Provider Reference Number. Apply at ukrlp.co.uk
# (free, 2–4 weeks). Cannot generate valid ILR exports without it.
AMBER_UKPRN=

# ── REQUIRED for encrypting org MIS credentials at rest (Phase 21) ──────
# 32-byte hex AES-256 key. Org-uploaded MIS API tokens (ProSolution, Maytas,
# EBS) are stored encrypted with this key. Rotating it requires re-encrypting
# all stored credentials — handle carefully.
MIS_CREDENTIALS_KEY=replace-with-32-bytes-hex

# ── REQUIRED for BullMQ queues, rate limiter, pre-cache ─────────────────
# Upstash free tier is sufficient for dev. Production: Upstash paid or
# Railway Redis. Must be a TLS (rediss://) URL for any managed provider.
# Server crashes at boot if missing or unreachable.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:<port>

# ── REQUIRED for Bull Board admin UI ────────────────────────────────────
# Secondary auth on top of JWT + admin role. Sent in the x-bull-board-token
# header on every /admin/queues request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BULL_BOARD_TOKEN=replace-with-64-hex-chars

# ── Optional — cache-refresh worker tuning ─────────────────────────────
# BullMQ lock duration for postcode + FALA load jobs (milliseconds).
# Defaults to 10 minutes. Raise if loading the full DfE master file from
# gov.uk (~83.6 MB / 3M rows) needs longer on production Redis.
LARGE_DATASET_TIMEOUT=600000

# ── Optional — postcode dataset source ─────────────────────────────────
# Production: URL to the DfE ASF master postcode CSV (download from
# https://www.gov.uk/government/publications/adult-skills-fund-asf-postcode-files
# and host on S3 / Vercel Blob / similar). Leave unset for dev — the
# bundled 10-postcode sample at src/data/postcode-sample.csv is used.
# POSTCODE_DATASET_URL=https://...
# POSTCODE_DATASET_PATH=/absolute/path/to/postcodes.csv

# ── REQUIRED for Stripe (marketplace bookings) ──────────────────────────
# Use sk_test_… for local dev. Webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── REQUIRED for Cloudinary (file uploads, profile pics) ────────────────
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── REQUIRED for transactional email (Nodemailer + privateemail.com) ────
AUTH_EMAIL=
AUTH_PASS=

# ── REQUIRED for Zoom meeting URLs on bookings ──────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── REQUIRED for ESOL AI tutor (Gemini 2.5 Flash via Vertex AI) ─────────
# Brief mandates europe-west4 — never europe-west2.
# These are the canonical names from the brief.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=europe-west4
# Path to the GCP service account JSON. Absolute paths only — dotenv does
# NOT expand ~ or environment variables.
# If the org policy blocks JSON key creation, leave this unset and use
# `gcloud auth application-default login` to set up ADC for local dev.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Model is hard-pinned in src/lib/gemini.ts (no version suffixes — they 404
# in europe-west4). GEMINI_MODEL kept for future override only.
GEMINI_MODEL=gemini-2.5-flash
# Legacy aliases — src/lib/gemini.ts also accepts these for backwards
# compatibility with pre-addendum .env files. Prefer the GOOGLE_CLOUD_*
# names above; these will be removed in a future cleanup.
# GCP_PROJECT_ID=
# GCP_LOCATION=europe-west4

# ── REQUIRED for safeguarding alert routing ─────────────────────────────
# Inbox that receives the warm-handoff alert when a learner message
# triggers safeguarding detection. Brief default: safeguarding@ambertraining.co.uk
# Note: existing code also reads SAFEGUARDING_ALERT_EMAIL — both names
# supported during the rename window. Prefer SAFEGUARDING_EMAIL.
SAFEGUARDING_EMAIL=safeguarding@ambertraining.co.uk
SAFEGUARDING_ALERT_EMAIL=safeguarding@ambertraining.co.uk

# ── REQUIRED for the demo environment (Function 16) ─────────────────────
# A SEPARATE MongoDB Atlas project from production. Demo data must never
# coexist with real learner data in the same cluster — the is_demo flag
# is a software guarantee, not a network guarantee. Use a different Atlas
# project entirely.
DEMO_MONGODB_URI=mongodb+srv://USER:PASS@demo-cluster.mongodb.net/amber-demo

# ── OPTIONAL ────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
DOMAIN_NAME=http://localhost:3000
ADMIN_EMAIL=
SUPPORT_EMAIL=
# OCR mock toggle — set true locally to skip Cloud Vision calls
MOCK_OCR=false
# Daily.co (alternative video provider, optional)
DAILY_API_KEY=

# ── CORS — additional origins (M0.4) ────────────────────────────────────
# Comma-separated origins to add on top of the hardcoded production +
# dev lists in src/config/cors.ts. Used for Vercel preview deploys whose
# hostnames aren't known at build time. Example:
#   EXTRA_CORS_ORIGINS=https://amber-esol-mvp-git-pr42-amber.vercel.app
EXTRA_CORS_ORIGINS=

# ── Voice (F28 TTS/STT, F32 speaking turns) ─────────────────────────────
# VOICE_TTS_ENABLED=true turns on server-side text-to-speech (Listen).
# VOICE_STT_ENABLED=true turns on speech-to-text AND the spoken-turn
# pronunciation flow (/turn-voice). Both default off.
# VOICE_MOCK=true (dev only; ignored when NODE_ENV=production) makes
# transcribeSpeech + assessPronunciation return canned results without
# calling Google, so the speaking flow can be rehearsed and tested
# offline. Still requires VOICE_STT_ENABLED=true.
VOICE_TTS_ENABLED=false
VOICE_STT_ENABLED=false
VOICE_MOCK=false

# Encrypts raw safeguarding disclosure text at rest (F22). 32-byte hex.
# Generate: node -e "console.log(require(\x27crypto\x27).randomBytes(32).toString(\x27hex\x27))"
# Fail-safe: if unset, disclosures stay in the append-only TurnLog (a warning logs).
SAFEGUARDING_ENCRYPTION_KEY=
