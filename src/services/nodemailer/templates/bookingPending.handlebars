<html>
  <head>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
      }
      .header {
        background: #0b2343;
        padding: 30px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        margin: 0;
        font-size: 24px;
      }
      .body {
        padding: 30px;
      }
      .body p {
        color: #333;
        line-height: 1.6;
      }
      .detail-box {
        background: #f9fafb;
        border-radius: 8px;
        padding: 16px;
        margin: 16px 0;
      }
      .btn {
        display: inline-block;
        background: #f59e0b;
        color: #ffffff;
        padding: 14px 32px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        margin: 20px 0;
      }
      .footer {
        padding: 20px 30px;
        background: #f9fafb;
        text-align: center;
        color: #9ca3af;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Booking Submitted</h1>
      </div>
      <div class="body">
        <p>Hi {{studentName}},</p>
        <p>Your
          {{#if isTrial}}trial {{/if}}booking request with
          <strong>{{tutorName}}</strong>
          has been submitted successfully!</p>
        <div class="detail-box">
          <p><strong>Sessions:</strong>
            {{slotCount}}
            slot{{#if (gt slotCount 1)}}s{{/if}}</p>
          <p><strong>Schedule:</strong> {{slotSummary}}</p>
          {{#unless isTrial}}<p><strong>Total:</strong>
              £{{totalAmount}}</p>{{/unless}}
        </div>
        <p>Your tutor will review your request shortly. You'll receive an email
          once it's confirmed.</p>
        <p style="text-align: center;">
          <a href="{{lessonsUrl}}" class="btn">View My Lessons</a>
        </p>
        <p>Best regards,<br />The Amber Training Team</p>
      </div>
      <div class="footer">
        <p>&copy; {{currentYear}} Amber Training. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>