<html>
  <head>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
      }
      .header {
        background: #0b2343;
        padding: 30px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        margin: 0;
        font-size: 24px;
      }
      .body {
        padding: 30px;
      }
      .body p {
        color: #333;
        line-height: 1.6;
      }
      .btn {
        display: inline-block;
        background: #f59e0b;
        color: #ffffff;
        padding: 14px 32px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        margin: 20px 0;
      }
      .footer {
        padding: 20px 30px;
        background: #f9fafb;
        text-align: center;
        color: #9ca3af;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Amber Training</h1>
      </div>
      <div class="body">
        <p>Hi {{name}},</p>
        <p>Thank you for registering with Amber Training. Please verify your
          email address by clicking the button below:</p>
        {{#if placementLevel}}
          <div
            style="background: #fff8ee; border: 1px solid rgba(255,124,34,0.3); border-radius: 12px; padding: 16px 20px; margin: 16px 0;"
          >
            <p
              style="margin: 0; font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.08em; color: #ff7c22;"
            >
              Your placement result
            </p>
            <p
              style="margin: 6px 0 0; font-size: 24px; font-weight: 800; color: #0b2343;"
            >
              {{placementLevel}}
            </p>
            {{#if placementRationale}}
              <p
                style="margin: 8px 0 0; font-size: 13px; color: #41506b; line-height: 1.5; font-style: italic;"
              >
                "{{placementRationale}}"
              </p>
            {{/if}}
            <p
              style="margin: 6px 0 0; font-size: 13px; color: #41506b; line-height: 1.5;"
            >
              Your lessons and practice scenarios will be matched to this level.
              Your teacher reviews every placement, so it can be adjusted if
              needed.
            </p>
          </div>
        {{/if}}
        <p style="text-align: center;">
          <a href="{{url}}" class="btn">Verify Email</a>
        </p>
        <p>If you did not create an account, please ignore this email.</p>
        <p>Best regards,<br />The Amber Training Team</p>
      </div>
      <div class="footer">
        <p>&copy; {{year}} Amber Training. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>