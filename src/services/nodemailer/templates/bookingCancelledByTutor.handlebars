<html>
  <head>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
      }
      .header {
        background: #0b2343;
        padding: 30px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        margin: 0;
        font-size: 24px;
      }
      .body {
        padding: 30px;
      }
      .body p {
        color: #333;
        line-height: 1.6;
      }
      .detail-box {
        background: #fef2f2;
        border-radius: 8px;
        padding: 16px;
        margin: 16px 0;
        border: 1px solid #fecaca;
      }
      .btn {
        display: inline-block;
        background: #f59e0b;
        color: #ffffff;
        padding: 14px 32px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: bold;
        margin: 20px 0;
      }
      .footer {
        padding: 20px 30px;
        background: #f9fafb;
        text-align: center;
        color: #9ca3af;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Booking Cancelled</h1>
      </div>
      <div class="body">
        <p>Hi {{studentName}},</p>
        <p>Unfortunately,
          <strong>{{tutorName}}</strong>
          has cancelled your upcoming lesson.</p>
        <div class="detail-box">
          <p><strong>Date:</strong> {{date}}</p>
          <p><strong>Time:</strong> {{time}}</p>
          <p><strong>Reason:</strong> {{reason}}</p>
        </div>
        {{#if refunded}}<p>A full refund has been issued to your payment method.
            Please allow 5–10 business days for it to appear.</p>{{/if}}
        <p>We apologise for the inconvenience. You can easily find and book with
          another tutor.</p>
        <p style="text-align: center;">
          <a href="{{findTutorsUrl}}" class="btn">Find Another Tutor</a>
        </p>
        <p>Best regards,<br />The Amber Training Team</p>
      </div>
      <div class="footer">
        <p>&copy; {{currentYear}} Amber Training. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>